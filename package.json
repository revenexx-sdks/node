{
  "name": "@revenexx/node",
  "homepage": "https://revenexx.com",
  "description": "Revenexx Node.js SDK.",
  "version": "0.5.1",
  "license": "MIT",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./file": {
      "import": {
        "types": "./dist/inputFile.d.mts",
        "default": "./dist/inputFile.mjs"
      },
      "require": {
        "types": "./dist/inputFile.d.ts",
        "default": "./dist/inputFile.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/revenexx-sdks/node"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/json-bigint": "1.0.4",
    "@types/node": "20.19.9",
    "eslint": "9.39.5",
    "tsup": "7.2.0",
    "esbuild-plugin-file-path-extensions": "^2.0.0",
    "tslib": "2.6.2",
    "typescript": "5.4.2",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "json-bigint": "1.0.0",
    "undici": "^7.16.0"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
